# Environment Configuration Example for NexusChat

# Application
NODE_ENV=development
PORT=3000

# Backend API
API_PORT=5000
API_URL=http://localhost:5000
JWT_SECRET=your_jwt_secret_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexuschat
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
