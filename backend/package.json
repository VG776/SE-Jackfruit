{
  "name": "nexuschat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NexusChat backend and real-time messaging server",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand",
    "test:integration": "node --test tests/test-*.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.13.3",
    "redis": "^4.7.0",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "nodemon": "3.1.9",
    "pg-mem": "3.0.5",
    "supertest": "7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "cacheDirectory": "<rootDir>/.jest-cache",
    "testTimeout": 15000
  }
}